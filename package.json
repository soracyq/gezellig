{
  "name": "dutchly",
  "version": "0.3.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts desktop/*.test.cjs",
    "export:web": "expo export --platform web",
    "format": "prettier --write src tests docs README.md DECISIONS.md",
    "format:check": "prettier --check src tests docs README.md DECISIONS.md",
    "build:imports": "node scripts/build-import-worker.cjs",
    "prestart": "npm run build:imports",
    "preweb": "npm run build:imports",
    "preexport:web": "npm run build:imports",
    "preview:web": "node scripts/preview-web.cjs",
    "desktop": "npm run export:web && node scripts/run-desktop.cjs",
    "desktop:open": "node scripts/run-desktop.cjs",
    "build:desktop": "npm run export:web && node scripts/build-desktop.cjs",
    "build:desktop:dir": "npm run export:web && node scripts/build-desktop.cjs --dir"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "exceljs": "^4.4.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "papaparse": "^5.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
